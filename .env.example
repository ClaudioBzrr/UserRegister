# Copy to .env and adjust the values for your environment.
# Used by docker compose (variable interpolation). The server itself reads
# its own .env file when run locally (see server/.env.example).

# Server
SERVER_PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string

# Optional: seed the first (admin) user on startup when both are set
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-123

# Production — Traefik / Let's Encrypt
APP_HOST=app.example.com
ADMIN_EMAIL=admin@example.com